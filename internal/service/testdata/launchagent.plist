<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.kephalaion</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/anna/.local/bin/kephalaion</string>
		<string>serve</string>
		<string>--config</string>
		<string>/Users/anna/a&amp;b &lt;c&gt;.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/Users/anna/.local/state/kephalaion/serve.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/anna/.local/state/kephalaion/serve.log</string>
</dict>
</plist>
